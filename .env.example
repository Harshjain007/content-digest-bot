# Telegram: talk to @BotFather, create a bot, paste the token here
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic: https://console.anthropic.com/  ->  API Keys
# Only needed when LLM_PROVIDER=anthropic. To go free+local, use LLM_PROVIDER=ollama.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# LLM backend: "anthropic" (paid, best quality) OR "ollama" (free, local, private).
# With "ollama", the bot calls a local Ollama server — no API key, no cost, data stays on your machine.
LLM_PROVIDER=anthropic

# Anthropic model (only when LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Ollama settings (only when LLM_PROVIDER=ollama)
# Install:  brew install ollama   (macOS)  then:  ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Instagram (OPTIONAL). Without these, reels often can't be scraped and the
# bot will ask you to paste the caption instead.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Max characters of extracted content sent to the LLM
MAX_INPUT_CHARS=30000
